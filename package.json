{
  "name": "packetpath",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/validate.ts && vite --host 0.0.0.0",
    "build": "node --import tsx scripts/validate.ts && tsc --noEmit && vite build",
    "test": "node --import tsx scripts/validate.ts && node --import tsx --test tests/*.test.ts",
    "start": "node serve.mjs",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
